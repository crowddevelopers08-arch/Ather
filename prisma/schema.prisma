generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id              String        @id @default(cuid())
  name            String
  phone           String
  email           String?
  
  // Lead details
  treatment       String?       // For Test Ride: ather-450, ather-rizta
  concern         String?       // For Test Ride: Location/Landmark
  preferredDateTime String?     // Preferred test ride time
  
  // Source tracking
  source          String?       @default("Website")
  formName        String?       @default("Test Ride Booking Form")
  consent         Boolean       @default(true)
  
  // Location tracking
  city            String?       // Store city/location
  state           String?       // Store state
  
  // TeleCRM integration fields
  telecrmSynced   Boolean       @default(false)
  telecrmId       String?
  telecrmError    String?
  
  // Lead management
  status          LeadStatus    @default(NEW)
  priority        LeadPriority  @default(MEDIUM)
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  syncedAt        DateTime?

  // Indexes for better query performance
  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([formName])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  SCHEDULED
  CONVERTED
  LOST
  INVALID
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}